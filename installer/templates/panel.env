ENVIRONMENT=production
PANEL_DOMAIN=@PANEL_DOMAIN@
PANEL_DB_PASSWORD=@DATABASE_PASSWORD@
DATABASE_URL=postgresql+asyncpg://nectarine:@DATABASE_PASSWORD@@127.0.0.1:5432/nectarine
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=@JWT_SECRET@
FIELD_ENCRYPTION_KEY=@FIELD_ENCRYPTION_KEY@
AGENT_URL=http://127.0.0.1:@AGENT_PORT@
AGENT_TOKEN=@AGENT_TOKEN@
NGINX_CONFIG_ROOT=/etc/nginx/vps-panel
PUBLIC_IP=@PUBLIC_IP@
LETSENCRYPT_EMAIL=@LETSENCRYPT_EMAIL@
STORAGE_ROOT=@STORAGE_ROOT@
CONFIG_ROOT=@CONFIG_DIR@
CORS_ORIGINS=https://@PANEL_DOMAIN@
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_WS_BASE=wss://@PANEL_DOMAIN@
TELEGRAM_BOT_TOKEN=@TELEGRAM_BOT_TOKEN@
TELEGRAM_OWNER_ID=@TELEGRAM_OWNER_ID@
TELEGRAM_API_TOKEN=@TELEGRAM_API_TOKEN@
BACKEND_INTERNAL_URL=http://127.0.0.1:@BACKEND_PORT@/api/v1
PUBLIC_BASE_URL=https://@PANEL_DOMAIN@
BACKEND_PORT=@BACKEND_PORT@
FRONTEND_PORT=@FRONTEND_PORT@
AGENT_PORT=@AGENT_PORT@
ADMINER_PORT=@ADMINER_PORT@
