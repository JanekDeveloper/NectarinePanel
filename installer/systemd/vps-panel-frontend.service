[Unit]
Description=NectarinePanel Nuxt frontend
After=network-online.target vps-panel-backend.service
Wants=network-online.target

[Service]
Type=simple
User=@PANEL_USER@
Group=@PANEL_USER@
WorkingDirectory=@INSTALL_DIR@/frontend
EnvironmentFile=@CONFIG_DIR@/panel.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=@FRONTEND_PORT@
ExecStart=/usr/bin/node @INSTALL_DIR@/frontend/.output/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
